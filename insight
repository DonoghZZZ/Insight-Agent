#!/usr/bin/env python3
"""
Insight Agent 快速启动脚本

用法:
  insight                # 交互模式
  insight crawl          # 启动爬虫
  insight analyze        # 启动分析
  insight chat           # AI 对话
  insight web            # Web UI
  insight tools          # 查看工具
  insight validate       # 验证系统
  insight help           # 显示帮助
"""

import sys
from pathlib import Path

# 添加项目路径
sys.path.insert(0, str(Path(__file__).parent))
sys.path.insert(0, str(Path(__file__).parent / "tools"))

def main():
    """主函数"""
    from cli_enhancer import CLIEnhancer
    
    enhancer = CLIEnhancer()
    
    if len(sys.argv) > 1:
        # 命令行模式
        command = sys.argv[1]
        args = sys.argv[2:]
        enhancer.execute_command(command, args)
    else:
        # 交互模式
        enhancer.interactive_mode()

if __name__ == "__main__":
    main()
